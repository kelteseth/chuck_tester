{
    "version": 4,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 18,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default config",
            "description": "Default build using Ninja generator",
            "hidden": true,
            "generator": "Ninja"
        },
        {
            "name": "default-64bit-linux",
            "displayName": "default 64bit GCC",
            "description": "Linux only!",
            "hidden": true,
            "inherits": "default",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_PREFIX_PATH": "${sourceDir}/build/Qt/6.11.0/gcc_64",
                "QT_QML_GENERATE_QMLLS_INI": "ON"
            }
        },
        {
            "name": "default-64bit-windows",
            "displayName": "default 64bit MSVC",
            "description": "Windows only!",
            "hidden": true,
            "inherits": "default",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_PREFIX_PATH": "C:/Qt/6.11.0/msvc2022_64",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "QT_QML_GENERATE_QMLLS_INI": "ON"
            }
        },
        {
            "name": "default-64bit-macos",
            "displayName": "default 64bit Clang",
            "description": "macOS only!",
            "hidden": true,
            "inherits": "default",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_PREFIX_PATH": "${sourceDir}/build/Qt/6.11.0/clang_64",
                "QT_QML_GENERATE_QMLLS_INI": "ON"
            }
        },
        {
            "name": "linux-debug-qt-6.11.0",
            "hidden": false,
            "inherits": "default-64bit-linux",
            "displayName": "⭐ 6.11.0 GCC 64bit Debug (Linux)",
            "binaryDir": "build/gcc_64_Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-release-qt-6.11.0",
            "hidden": false,
            "inherits": "default-64bit-linux",
            "displayName": "6.11.0 GCC 64bit Release (Linux)",
            "binaryDir": "build/gcc_64_Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "windows-debug-qt-6.11.0",
            "hidden": false,
            "inherits": "default-64bit-windows",
            "displayName": "⭐ 6.11.0 MSVC 64bit Debug (Windows)",
            "binaryDir": "build/MSVC_64bit_Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-release-qt-6.11.0",
            "hidden": false,
            "inherits": "default-64bit-windows",
            "displayName": "6.11.0 MSVC 64bit Release (Windows)",
            "binaryDir": "build/MSVC_64bit_Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "macos-debug-qt-6.11.0",
            "hidden": false,
            "inherits": "default-64bit-macos",
            "displayName": "⭐ 6.11.0 Clang 64bit Debug (macOS)",
            "binaryDir": "build/clang_64_Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "macos-release-qt-6.11.0",
            "hidden": false,
            "inherits": "default-64bit-macos",
            "displayName": "6.11.0 Clang 64bit Release (macOS)",
            "binaryDir": "build/clang_64_Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-debug-build",
            "displayName": "Linux Debug Build",
            "description": "Build preset for Linux Debug configuration",
            "configurePreset": "linux-debug-qt-6.11.0"
        },
        {
            "name": "linux-release-build",
            "displayName": "Linux Release Build",
            "description": "Build preset for Linux Release configuration",
            "configurePreset": "linux-release-qt-6.11.0"
        },
        {
            "name": "windows-debug-build",
            "displayName": "Windows Debug Build",
            "description": "Build preset for Windows Debug configuration",
            "configurePreset": "windows-debug-qt-6.11.0"
        },
        {
            "name": "windows-release-build",
            "displayName": "Windows Release Build", 
            "description": "Build preset for Windows Release configuration",
            "configurePreset": "windows-release-qt-6.11.0"
        },
        {
            "name": "macos-debug-build",
            "displayName": "macOS Debug Build",
            "description": "Build preset for macOS Debug configuration",
            "configurePreset": "macos-debug-qt-6.11.0"
        },
        {
            "name": "macos-release-build",
            "displayName": "macOS Release Build",
            "description": "Build preset for macOS Release configuration",
            "configurePreset": "macos-release-qt-6.11.0"
        }
    ]
}
